generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  content     String?
  coverImage  String?
  tags        String[]
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("blog_posts")
}

model Video {
  id          String    @id @default(cuid())
  title       String
  youtubeUrl  String
  thumbnail   String?
  description String?
  category    String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("videos")
}

model Resource {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  description String?
  coverImage  String?
  notionLink  String?
  category    String?
  featured    Boolean    @default(false)
  downloads   Download[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("resources")
}

model Subscriber {
  id                 String     @id @default(cuid())
  email              String     @unique
  name               String?
  source             String?
  resourceDownloaded String?
  createdAt          DateTime   @default(now())
  downloads          Download[]

  @@map("subscribers")
}

model Download {
  id           String     @id @default(cuid())
  subscriberId String
  resourceId   String
  createdAt    DateTime   @default(now())
  subscriber   Subscriber @relation(fields: [subscriberId], references: [id])
  resource     Resource   @relation(fields: [resourceId], references: [id])

  @@map("downloads")
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  referrer  String?
  createdAt DateTime @default(now())

  @@map("page_views")
}
